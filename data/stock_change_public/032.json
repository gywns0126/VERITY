한 국내외 관련 산업분야로의 진출도 활발히 이루어지고 있습니다.\n\n◎ 원자력사업\n\n1993년 회사 설립부터 현재까지 원자력발전소의 감시, 경보, 제어시스템을 100% 자체 기술로 개발하여 공급하고 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001668","hash":"41ff9a8b826c122398b3d6624b793b76e881e59510248604c248004c30dfb57a"},"previous":null,"added":[],"removed":[]},"employment_performance":{"status":"ready","employment":{"as_of":"202607","count":183.0,"previous_as_of":"202606","previous_count":186.0,"growth_pct":-1.6,"hire":3.0,"leave":2.0,"net":1.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":2025,"previous_as_of":2024,"revenue":87135395389.0,"revenue_previous":71250184948.0,"revenue_growth_pct":22.3,"operating_profit":-5486712823.0,"operating_profit_previous":553922286.0,"operating_profit_growth_pct":-1090.5,"source":"DART 연간 재무"},"relationship":"mixed_direction","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"ready","events":[{"date":"2026-08-21","category":"정정공시","title":"[기재정정]단일판매ㆍ공급계약체결              ","is_correction":true,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260821900397"},{"date":"2026-08-05","category":"전환사채(CB)","title":"주요사항보고서(전환사채권발행결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260805000463"},{"date":"2026-07-27","category":"정정공시","title":"[기재정정]단일판매ㆍ공급계약체결              ","is_correction":true,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260727900247"}],"event_total":3,"instruments":[],"dilution_pct":null,"note":"공시 제목 분류 이력이며 현재 잔존 물량 확정값이 아니다."},"coverage":{"hit":5,"total":6,"fields":{"daily_pair":true,"business_report":true,"business_previous":false,"employment":true,"financial_pair":true,"capital_history":true}}},"032790":{"ticker":"032790","name":"엠젠솔루션","market":"KOSDAQ","today":{"status":"insufficient_history","as_of":"","previous_as_of":null,"fields":[],"disclosures":[]},"business_report":{"status":"baseline","current":{"fiscal_year":"2025","filed_at":"20260320","report":"사업보고서 (2025.12)","text":"연결회사가 영위하고 있는 사업은 크게 ICT(광대역통신망 구축사업, 홈IoT 사업, 소방전기사업 등), Bio(바이오 조직공학 연구 등), 전기전자(트랜스, 인덕터 등) 사업부문으로 구분할 수 있습니다.연결회사의 사업부문은 다음과 같습니다.\n\n구분\n\n사업내용\n\n주요거래처\n\n비고\n\nICT사업부\n\n광대역자가통신망 운영 및 구축 인공지능 영상분석 솔루션 등\n\n관공서 등\n\n주1)\n\n스마트서비스\n\n직방(구.삼성SDS)\n\n-\n\n소방, 전기 공사 등\n\n관공서 등\n\n주2)\n\n현상기사업부\n\n프린터 현상기 등\n\n폭스콘(구.HPPS)\n\n주5)\n\n전기전자사업부\n\n트랜스, 인덕터 등 전기전자제품 제조 및 공급 등\n\n삼성전자 등\n\n주3)\n\nBio사업부\n\n조직공학 연구, 의료기기 개발 등\n\n대학병원, 전문병원 등\n\n주4)\n\n주1) ICT사업부는 전국 지자체에 자가망 설치 및 유지관리, 인공지능(AI) 영상분석 솔루션을 제작, 납품하고 있습니다. 또한, 홈IoT사업을 영위하며 월패드 등을 납품하고 있으며, AI재난안전솔루션을 납품하고 있습니다.주2) 2023년 5월 11일 현대인프라코어(주) 주식 및 경영권 양수도 계약을 체결하였습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260320000990","hash":"5c92d76427e9dfd1d80532040027ff8fe808d6addcbc5d2a6c0f8f0ad86f9f02"},"previous":null,"added":[],"removed":[]},"employment_performance":{"status":"partial","employment":{"as_of":"202607","count":79.0,"previous_as_of":null,"previous_count":null,"growth_pct":null,"hire":2.0,"leave":1.0,"net":1.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":null,"previous_as_of":null,"revenue":null,"revenue_previous":null,"revenue_growth_pct":null,"operating_profit":null,"operating_profit_previous":null,"operating_profit_growth_pct":null,"source":"DART 연간 재무"},"relationship":"insufficient","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"ready","events":[{"date":"2026-06-30","category":"전환사채(CB)","title":"주요사항보고서(자기전환사채만기전취득결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260630001033"},{"date":"2026-06-15","category":"전환사채(CB)","title":"[기재정정]주요사항보고서(자기전환사채매도결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260615000429"}],"event_total":2,"instruments":[],"dilution_pct":null,"note":"공시 제목 분류 이력이며 현재 잔존 물량 확정값이 아니다."},"coverage":{"hit":3,"total":6,"fields":{"daily_pair":false,"business_report":true,"business_previous":false,"employment":true,"financial_pair":false,"capital_history":true}}},"032280":{"ticker":"032280","name":"삼일","market":"KOSDAQ","today":{"status":"insufficient_history","as_of":"","previous_as_of":null,"fields":[],"disclosures":[]},"business_report":{"status":"baseline","current":{"fiscal_year":"2025","filed_at":"20260319","report":"사업보고서 (2025.12)","text":"당사는 창사 61주년을 맞은 운송중견업체로써 운송관련 KNOW-HOW 축적의 기술력과 특수화물 자동차운송사업, 특별보세운송, 화물주선업, 창고보관업, 하역업등의 복합화물 운송 업체가 보유할 수 있는 다양한 자격, 면허를 보유하고 있으며 포항을 본사로 하여 인천, 당진, 대구, 부산, 광양, 창원등지의 전국적인 영업망과 최신 자동화 창고시설 및 최신기종의 차량장비를 갖추고 있며 POSCO의 철강제품을 비롯한 전국적인 화물수송과 이어 연계된 항만하역 및 철도소 운송 사업을 영위하고 있습니다.","truncated":false,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260319000769","hash":"d14f62bf909f57c563d3d393d6080097a46c263fcb9e1a27cde03266cde505d3"},"previous":null,"added":[],"removed":[]},"employment_performance":{"status":"partial","employment":{"as_of":"202607","count":42.0,"previous_as_of":null,"previous_count":null,"growth_pct":null,"hire":2.0,"leave":2.0,"net":0.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":null,"previous_as_of":null,"revenue":null,"revenue_previous":null,"revenue_growth_pct":null,"operating_profit":null,"operating_profit_previous":null,"operating_profit_growth_pct":null,"source":"DART 연간 재무"},"relationship":"insufficient","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"no_record","events":[],"event_total":0,"instruments":[],"dilution_pct":null,"note":"공시 제목 분류 이력이며 현재 잔존 물량 확정값이 아니다."},"coverage":{"hit":2,"total":6,"fields":{"daily_pair":false,"business_report":true,"business_previous":false,"employment":true,"financial_pair":false,"capital_history":false}}},"032860":{"ticker":"032860","name":"더라미","market":"KOSDAQ","today":{"status":"insufficient_history","as_of":"","previous_as_of":null,"fields":[],"disclosures":[]},"business_report":{"status":"baseline","current":{"fiscal_year":"2025","filed_at":"20260320","report":"사업보고서 (2025.12)","text":"당사는 금속 및 비금속 원료재생사업 부문인 철스크랩 유통사업을 영위해 오다가 2021년 수익형 부동산(오버더마운틴 리조트)을 양수하여 경기도 가평군에서 리조트사업(가족호텔)을 운영하고 있으며, 또한 2023년 라미화장품(주)을 흡수합병하여 화장품 사업을 주사업으로 영위하고 있습니다.\n\n가. 화장품 사업\n\n(1) 산업의 특성\n\n국내 화장품 산업은 기능성 원료, 신원료, 신제형 개발을 통한 기술혁신과 더불어 K-뷰티의 글로벌 인지도 확산으로 빠르게 성장하고 있습니다. 최근 소비자 요구는 단순 미용 목적에서 나아가 기능성·친환경·맞춤형 제품 중심으로 변화하고 있으며, 이에 따라 한방, 유기농, 메디컬 코스메틱 등 고기능성 제품군이 시장 성장을 주도하고 있습니다.또한, 페이스케어 위주의 기존 시장에서 헤어·두피 관리, 바디케어, 남성용 화장품 등으로 수요가 다변화되고 있습니다. 친환경 원료를 사용하거나 지속가능한 패키징을 적용한 제품이 확산되고 있으며, 이는 ESG 경영 및 글로벌 친환경 트렌드와 맞물려 새로운 성장 기회로 작용하고 있습니다.유통채널 또한 오프라인 중심 구조에서 온라인 쇼핑몰, 홈쇼핑, 소셜커머스 등 디지털 유통채널 중심으로 재편되고 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260320001093","hash":"5a6fc67d35250d035fd2e2e8988319d66b6808824b0dee60845607196d954eda"},"previous":null,"added":[],"removed":[]},"employment_performance":{"status":"partial","employment":{"as_of":"202607","count":38.0,"previous_as_of":null,"previous_count":null,"growth_pct":null,"hire":0.0,"leave":1.0,"net":-1.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":null,"previous_as_of":null,"revenue":null,"revenue_previous":null,"revenue_growth_pct":null,"operating_profit":null,"operating_profit_previous":null,"operating_profit_growth_pct":null,"source":"DART 연간 재무"},"relationship":"insufficient","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"no_record","events":[],"event_total":0,"instruments":[],"dilution_pct":null,"note":"공시 제목 분류 이력이며 현재 잔존 물량 확정값이 아니다."},"coverage":{"hit":2,"total":6,"fields":{"daily_pair":false,"business_report":true,"business_previous":false,"employment":true,"financial_pair":false,"capital_history":false}}},"032830":{"ticker":"032830","name":"삼성생명","market":"KOSPI","today":{"status":"insufficient_history","as_of":"2026-05-11","previous_as_of":null,"fields":[],"disclosures":[]},"business_report":{"status":"baseline","current":{"fiscal_year":"2025","filed_at":"20260331","report":"[기재정정]사업보고서 (2025.12)","text":"[지배회사(삼성생명보험)]\n\n삼성생명은 1960년대부터 국내 1위의 생명보험회사로 한국에서 가장 큰 삼성그룹 내 대표기업 중 하나입니다. 국내 최고 브랜드 중 하나라는 이점을 바탕으로 법인 고객에게 단체생명보험과 퇴직연금을, 개인 고객에게는 생명보험과 연금보험 등 다양한 상품 및 서비스를 제공하고 있습니다. 당사는 2025년 12월말 현재 2,026만건의 보험계약을 보유하고 있습니다.\n\n당사가 판매하는 보험상품은 생존보험, 사망보험, 생사혼합보험, 단체보험 및 퇴직연금 등으로 구성되며, 2025년 12월말 기준으로 수입보험료 규모는 각각 3조 8,542억원(14.42%), 13조 6,144억원(50.92%), 3,369억원(1.26%), 4,212억원(1.58%), 8조 5,075억원(31.82%) 으로 총 26조 7,342억원의 실적을 거두었습니다.이에 따른 2025년 12월말 누적 기준 준비금 평잔은 257조 9,216억원 입니다.\n\n당사는 고객으로부터 수령한 보험료에 대한 이자 및 미래 보험금 지급 등을 위하여 자산을 운용하고 그 결과인 운용이익으로 고객을 위한 책임준비금을 관리하고 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260331004244","hash":"4598cd664af7a91d3becbe02d9e230d47d47cbdebaeda0a435e12e3f234426f3"},"previous":null,"added":[],"removed":[]},"employment_performance":{"status":"partial","employment":{"as_of":"202607","count":null,"previous_as_of":null,"previous_count":null,"growth_pct":null,"hire":null,"leave":null,"net":null,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":2025,"previous_as_of":2024,"revenue":null,"revenue_previous":null,"revenue_growth_pct":null,"operating_profit":2580469000000.0,"operating_profit_previous":2499751000000.0,"operating_profit_growth_pct":3.2,"source":"DART 연간 재무"},"relationship":"insufficient","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"no_record","events":[],"event_total":0,"instruments":[],"dilution_pct":null,"note":"공시 제목 분류 이력이며 현재 잔존 물량 확정값이 아니다."},"coverage":{"hit":2,"total":6,"fields":{"daily_pair":false,"business_report":true,"business_previous":false,"employment":false,"financial_pair":true,"capital_history":false}}},"032640":{"ticker":"032640","name":"LG유플러스","market":"KOSPI","today":{"status":"changed","as_of":"2026-08-27","previous_as_of":"2026-08-26","fields":[{"key":"price","label":"가격","before":14900.0,"after":14720.0,"delta":-180.0,"delta_pct":-1.21},{"key":"market_cap","label":"시가총액","before":6323973390336.0,"after":0.0,"delta":-6323973390336.0,"delta_pct":-100.0},{"key":"per","label":"PER","before":7.68,"after":7.58,"delta":-0.1,"delta_pct":-1.3}],"source":"data/stock_history 일별 스냅샷","disclosures":[]},"business_report":{"status":"baseline","current":{"fiscal_year":"2025","filed_at":"20260313","report":"사업보고서 (2025.12)","text":"㈜LG유플러스의 사업 부문은 한국표준산업분류에 의거하여 전기통신업으로 분류되고 있으며, 모바일ㆍ스마트홈ㆍ기업인프라 등의 사업을 영위하고 5G기술을 바탕으로 각 사업의 미래 성장동력을 발전시켜 나가고 있습니다. ㈜LG유플러스는 최근 AI 및 데이터 인프라 역량 강화를 통해 미래 성장기반을 다지고 있습니다. 특히, 고도화된 고객 맞춤형 서비스를 위한 AI 기술 확보에 집중하고 있으며, 경기도 파주에 신규 AIDC 구축을 추진하여 클라우드 및 AI 연산 수요 증가에 대응하고자 합니다. 이러한 투자와 기술 역량 강화를 통해 AI 시대에 최적화된 디지털 인프라 기업으로의 도약을 준비하고 있습니다.㈜LG유플러스의 2025년 4분기말 현재 모바일 누적 회선수는 3,071만 회선이며, 당사가 수용가능한 최대 회선수 대비 75.2%의 가동률을 보이고 있습니다.\n\n2025년 연결기준 서비스수익은 전년 대비 3.5% 성장한 12조 2,633억원을 기록하였으며, 별도기준으로는 전년 대비 3.6% 성장한 11조 3,826억원을 기록했습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260313000442","hash":"0126ea095637a44adafd15710fc1ab9d56ea77257256df8b3bcac3a80e399c54"},"previous":null,"added":[],"removed":[]},"employment_performance":{"status":"ready","employment":{"as_of":"202607","count":9334.0,"previous_as_of":"202606","previous_count":9320.0,"growth_pct":0.2,"hire":76.0,"leave":63.0,"net":13.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":2025,"previous_as_of":2024,"revenue":15451745000000.0,"revenue_previous":14625198000000.0,"revenue_growth_pct":5.7,"operating_profit":892131000000.0,"operating_profit_previous":863130000000.0,"operating_profit_growth_pct":3.4,"source":"DART 연간 재무"},"relationship":"same_direction","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"no_record","events":[],"event_total":0,"instruments":[],"dilution_pct":null,"note":"공시 제목 분류 이력이며 현재 잔존 물량 확정값이 아니다."},"coverage":{"hit":4,"total":6,"fields":{"daily_pair":true,"business_report":true,"business_previous":false,"employment":true,"financial_pair":true,"capital_history":false}}},"032980":{"ticker":"032980","name":"바이온","market":"KR","today":{"status":"insufficient_history","as_of":"","previous_as_of":null,"fields":[],"disclosures":[]},"business_report":{"status":"