pair":true,"capital_history":true}}},"393210":{"ticker":"393210","name":"토마토시스템","market":"KOSDAQ","today":{"status":"changed","as_of":"2026-07-01","previous_as_of":"2026-05-11","fields":[{"key":"price","label":"가격","before":4005.0,"after":2520.0,"delta":-1485.0,"delta_pct":-37.08},{"key":"market_cap","label":"시가총액","before":61598724096.0,"after":38758748160.0,"delta":-22839975936.0,"delta_pct":-37.08}],"source":"data/stock_history 일별 스냅샷","disclosures":[]},"business_report":{"status":"unchanged","current":{"fiscal_year":"2025","filed_at":"20260319","report":"사업보고서 (2025.12)","text":"가. 사업 개황\n\n주식회사 토마토시스템은 2000년 설립하여 대한민국 정보기술의 발전과 함께 성장해온 국내 대표 IT/솔루션 전문기업입니다. 당사는 대학사업 분야에서 독보적인 위치를구축하였으며, 공공·기업·금융·제조 등 다양한 사업 분야에서도 고객의 요구에 부합하는 새로운 가치를 창출하고, 기술혁신을 제공하는 솔루션 전문기업으로 자리매김하고 있습니다. \n\n \n\n설립 초기부터 대학 시장에 집중해 적극적인 시장 공략을 이어온 결과, 토마토시스템은 확고한 기술력과 경쟁력을 확보하였으며 현재 국내 100여 곳 이상의 대학을 고객사로 두고 있습니다. 또한 신뢰를 바탕으로 고객과 장기적인 파트너십을 구축하여 한번 인연을 맺은 고객과는 지속적으로 협력 관계를 강화하고 있습니다.\n\n \n\n또한 현장 경험과 기술 노하우를 바탕으로, 시장의 변화와 트렌드에 부응하는 제품을지속적으로 연구·개발해왔습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260319001206","hash":"4deb0440ab587653acb49ab806b9287479850efdf7b1eeb5fd2d1c3bd2a00a69"},"previous":{"fiscal_year":"2025","filed_at":"20260319","report":"사업보고서 (2025.12)","text":"가. 사업 개황\n\n주식회사 토마토시스템은 2000년 설립하여 대한민국 정보기술의 발전과 함께 성장해온 국내 대표 IT/솔루션 전문기업입니다. 당사는 대학사업 분야에서 독보적인 위치를구축하였으며, 공공·기업·금융·제조 등 다양한 사업 분야에서도 고객의 요구에 부합하는 새로운 가치를 창출하고, 기술혁신을 제공하는 솔루션 전문기업으로 자리매김하고 있습니다. \n\n \n\n설립 초기부터 대학 시장에 집중해 적극적인 시장 공략을 이어온 결과, 토마토시스템은 확고한 기술력과 경쟁력을 확보하였으며 현재 국내 100여 곳 이상의 대학을 고객사로 두고 있습니다. 또한 신뢰를 바탕으로 고객과 장기적인 파트너십을 구축하여 한번 인연을 맺은 고객과는 지속적으로 협력 관계를 강화하고 있습니다.\n\n \n\n또한 현장 경험과 기술 노하우를 바탕으로, 시장의 변화와 트렌드에 부응하는 제품을지속적으로 연구·개발해왔습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260319001206","hash":"4deb0440ab587653acb49ab806b9287479850efdf7b1eeb5fd2d1c3bd2a00a69"},"added":[],"removed":[]},"employment_performance":{"status":"ready","employment":{"as_of"