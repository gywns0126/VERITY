국내 유일의 고로업체인 POSCO의 열연제품 지정판매점으로 선정되어 국내 철강재 공급의 일익을 담당하며 지속적인 성장을 하여 왔습니다. 당사는 포항공장에 1989년 Die Shear Line을 설치를 계기로 단순유통업에서 종합적인 철강재 Coil Service Center로 전환하였으며 현재에는 포항과 인천에 Rotary Shear Line 및 Slitter Line등 5기의 Coil Service 설비를 보유 가동하고 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000232","hash":"fd75bedfc003aaf5d56284d344d896b5f8876d4526129e2e7082e14b67f682ac"},"previous":null,"added":[],"removed":[]},"employment_performance":{"status":"partial","employment":{"as_of":"202607","count":45.0,"previous_as_of":null,"previous_count":null,"growth_pct":null,"hire":3.0,"leave":0.0,"net":3.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":null,"previous_as_of":null,"revenue":null,"revenue_previous":null,"revenue_growth_pct":null,"operating_profit":null,"operating_profit_previous":null,"operating_profit_growth_pct":null,"source":"DART 연간 재무"},"relationship":"insufficient","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"no_record","events":[],"event_total":0,"instruments":[],"dilution_pct":null,"note":"공시 제목 분류 이력이며 현재 잔존 물량 확정값이 아니다."},"coverage":{"hit":2,"total":6,"fields":{"daily_pair":false,"business_report":true,"business_previous":false,"employment":true,"financial_pair":false,"capital_history":false}}},"048430":{"ticker":"048430","name":"유라테크","market":"KOSDAQ","today":{"status":"changed","as_of":"2026-08-24","previous_as_of":"2026-08-21","fields":[{"key":"price","label":"가격","before":6010.0,"after":6070.0,"delta":60.0,"delta_pct":1.0},{"key":"market_cap","label":"시가총액","before":68832239616.0,"after":69519417344.0,"delta":687177728.0,"delta_pct":1.0}],"source":"data/stock_history 일별 스냅샷","disclosures":[]},"business_report":{"status":"baseline","current":{"fiscal_year":"2025","filed_at":"20260317","report":"사업보고서 (2025.12)","text":"당사는 자동차용 점화코일, 점화 플러그를 제조 판매하는 자동차부품전문업체 입니다. 주요 고객으로 현대/기아자동차, 현대모비스 등으로 안정적인 매출이 이루어 지고 있습니다. 2012년 10월에 설립된 당사의 종속회사 일조승우무역유한공사는 2012년 12월 01일 영업을 개시하여 자동차부품의 수출입과 도매 등 소싱 및 판매 사업을 영위하고 있으며, 영업활동은 주로 중국 현지내 원자재 공급업체 개발, 경쟁력있는 자재를 확보하여 현지 자동차 부품 제조 업체로 공급됩니다. 2019년 9월에 설립된 당사의 종속회사 유라테크베트남유한회사는 자동차 부품 임가공으로 국내 자동차 부품 제조 업체로 공급됩니다.\n\n2025년 자동차산업은 美 신공장 가동, 25% 고관세 부과 등 불안 요인에도 불구, 내수 방어와 미국 수출 감소를 유럽 친환경차 수출 확대로 보완하여 전년대비 0.6% 감소한 411만대를 생산하여 예상보다 양호한 실적을 보였습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000545","hash":"404445b95e0d952cafb72f48bc5111bfdd4edbde94d679f181ce1259098d94a7"},"previous":null,"added":[],"removed":[]},"employment_performance":{"status":"ready","employment":{"as_of":"202607","count":251.0,"previous_as_of":"202606","previous_count":251.0,"growth_pct":0.0,"hire":0.0,"leave":0.0,"net":0.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":2025,"previous_as_of":2024,"revenue":197253919651.0,"revenue_previous":201350449443.0,"revenue_growth_pct":-2.0,"operating_profit":1814073099.0,"operating_profit_previous":10506324936.0,"operating_profit_growth_pct":-82.7,"source":"DART 연간 재무"},"relationship":"mixed_direction","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"no_record","events":[],"event_total":0,"instruments":[],"dilution_pct":null,"note":"공시 제목 분류 이력이며 현재 잔존 물량 확정값이 아니다."},"coverage":{"hit":4,"total":6,"fields":{"daily_pair":true,"business_report":true,"business_previous":false,"employment":true,"financial_pair":true,"capital_history":false}}},"048410":{"ticker":"048410","name":"현대바이오","market":"KOSDAQ","today":{"status":"changed","as_of":"2026-08-27","previous_as_of":"2026-08-26","fields":[{"key":"price","label":"가격","before":6580.0,"after":6440.0,"delta":-140.0,"delta_pct":-2.13},{"key":"market_cap","label":"시가총액","before":634991804416.0,"after":621481361408.0,"delta":-13510443008.0,"delta_pct":-2.13}],"source":"data/stock_history 일별 스냅샷","disclosures":[]},"business_report":{"status":"baseline","current":{"fiscal_year":"2025","filed_at":"20260330","report":"[기재정정]사업보고서 (2025.12)","text":"현대바이오사이언스는 2000년 5월 25일 현대전자로부터 분사하여 설립된 바이오 제약 및 코스메슈티컬 기업으로 신약 개발과 기능성 화장품 사업을 병행하고 있습니다.\n\n2012년부터 시작한 바이오 사업을 본격적으로 추진하기 위해 기존 IT사업 대부분을 2018년 6월부로 중단하고 같은 해 8월 회사명을 현대바이오사이언스로 변경하였습니다.\n\n현재, 경상북도 김천에 위치한 생산공장과 일본, 미국 등 해외 합작법인 및 자회사를 통해 연구개발(R&D) 및 안정적인 생산·판매망을 구축하고 있으며, 최대주주인 ㈜씨앤팜과 협력하여 범용 항바이러스 치료제 개발과 자체 약물전달 기술을 기반으로 만든 무고통 항암제 폴리탁셀, 기존 항암제의 내성 및 전이를 해결하는 획기적인 약물 흡수 치료제 페니트리움 개발과 이와 관련한 임상시험을 준비하고 있으며 자체 약물전달 기반 기술을 바탕으로 만든 독자적 화장품 브랜드 '비타브리드 C12'를 일본 수출 뿐만 아니라 글로벌 시장을 대상으로 화장품 사업을 확장하고 있으며, 신규 화장품 라인업인 'Dr.BRID C'를 통해 국내 및 글로벌 시장으로 사업을 확장하고 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260330001311","hash":"e61c4c0f5b1ef5092212ab9ea5b2b0aa8e14c9745a947295dab8ea473a1189fc"},"previous":null,"added":[],"removed":[]},"employment_performance":{"status":"ready","employment":{"as_of":"202607","count":5.0,"previous_as_of":"202606","previous_count":6.0,"growth_pct":-16.7,"hire":0.0,"leave":0.0,"net":0.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":2025,"previous_as_of":2024,"revenue":3517369223.0,"revenue_previous":15050025356.0,"revenue_growth_pct":-76.6,"operating_profit":-18160910580.0,"operating_profit_previous":790972784.0,"operating_profit_growth_pct":-2396.0,"source":"DART 연간 재무"},"relationship":"same_direction","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"ready","events":[{"date":"2026-06-23","category":"전환사채(CB)","title":"주요사항보고서(전환사채매수선택권행사자지정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260623000313"},{"date":"2026-06-15","category":"전환사채(CB)","title":"주요사항보고서(전환사채권발행결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260615000419"}],"event_total":2,"instruments":[],"dilution_pct":null,"note":"공시 제목 분류 이력이며 현재 잔존 물량 확정값이 아니다."},"coverage":{"hit":5,"total":6,"fields":{"daily_pair":true,"business_report":true,"business_previous":false,"employment":true,"financial_pair":true,"capital_history":true}}}}}