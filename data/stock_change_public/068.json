l":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20210603000184"},{"date":"2016-03-14","category":"유상증자","title":"주요사항보고서(유상증자결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20160314000661"},{"date":"2015-10-15","category":"유상증자","title":"주요사항보고서(유상증자결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20151015000189"}],"event_total":5,"instruments":[],"dilution_pct":null,"note":"공시 제목 분류 이력이며 현재 잔존 물량 확정값이 아니다."},"coverage":{"hit":4,"total":6,"fields":{"daily_pair":false,"business_report":true,"business_previous":true,"employment":true,"financial_pair":false,"capital_history":true}}},"068100":{"ticker":"068100","name":"케이웨더","market":"KOSDAQ","today":{"status":"insufficient_history","as_of":"","previous_as_of":null,"fields":[],"disclosures":[]},"business_report":{"status":"unchanged","current":{"fiscal_year":"2025","filed_at":"20260319","report":"사업보고서 (2025.12)","text":"당사는 1997년 기상업무법의 민간예보사업제도 도입에 맞추어 설립된 국내 최대 민간기상사업자로서 날씨 빅데이터플랫폼을 통하여 기상 및 날씨와 관련한 개인과 기업고객의 리스크를 줄이고, 삶의 질을 향상시키는 것을 사업 목표로 하고 있습니다.당사의 날씨 빅데이터플랫폼은 기상 빅데이터플랫폼과 공기 빅데이터플랫폼으로 구성되어 있습니다.\n\n① 기상 빅데이터플랫폼을 통해 4,000여 회원사에 기상 데이터를 유통하고, 독자적인 민간예보 등 맞춤형 데이터를 제공합니다. 이를 통해 고객이 다양한 기상 위험을 효과적으로 관리할 수 있도록 지원합니다.\n\n② 공기 빅데이터플랫폼은 실외 미세먼지와 오존 등 대기오염 요소에 대한 공기질 데이터를 제공하고, 고객 생활공간의 공기질 상태를 측정 및 분석하여 실내 공간을 청정하게 유지할 수 있도록 합니다.\n\n케이웨더 날씨 빅데이터플랫폼\n\n 당사는 그동안 쌓아온 경험과 연구를 통해 데이터(Data), 제품(Product), 서비스(Service) 3가지 측면에 집중하는 것이 고객에게 가치를 전달하는 가장 효율적인 방식임을 결론지었고, 이를 바탕으로 DSP 사업모델을 추진하고 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260319000742","hash":"64e3b2f03266435e5f139a7d98e2eb4ab177ec91005bee75c8d653d9fd51c8bc"},"previous":{"fiscal_year":"2025","filed_at":"20260319","report":"사업보고서 (2025.12)","text":"당사는 1997년 기상업무법의 민간예보사업제도 도입에 맞추어 설립된 국내 최대 민간기상사업자로서 날씨 빅데이터플랫폼을 통하여 기상 및 날씨와 관련한 개인과 기업고객의 리스크를 줄이고, 삶의 질을 향상시키는 것을 사업 목표로 하고 있습니다.당사의 날씨 빅데이터플랫폼은 기상 빅데이터플랫폼과 공기 빅데이터플랫폼으로 구성되어 있습니다.\n\n① 기상 빅데이터플랫폼을 통해 4,000여 회원사에