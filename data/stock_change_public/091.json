ial_pair":true,"capital_history":true}}},"091120":{"ticker":"091120","name":"이엠텍","market":"KOSDAQ","today":{"status":"changed","as_of":"2026-08-27","previous_as_of":"2026-08-26","fields":[{"key":"price","label":"가격","before":4850.0,"after":4845.0,"delta":-5.0,"delta_pct":-0.1},{"key":"market_cap","label":"시가총액","before":76658343936.0,"after":76579315712.0,"delta":-79028224.0,"delta_pct":-0.1}],"source":"data/stock_history 일별 스냅샷","disclosures":[]},"business_report":{"status":"unchanged","current":{"fiscal_year":"2025","filed_at":"20260318","report":"사업보고서 (2025.12)","text":"가. 사업구분\n\n당사의 사업부문은 부품사업부문과 제품사업부문으로 구분되어 있습니다.부품사업부문은 휴대폰, Smart Watch, TWS 등에 들어가는 Module Ass'y, Speaker, Vibration Motor를 주력사업으로 추진하고 있고, 자동차용 전장메카, 햅틱 모듈 분야로 사업을 성장시켜 가고 있습니다.\n\n제품사업부문은 전자담배, 자동주사기의 2개 분야 사업을 추진하고 있으며 지적재산권을 확보한 자사개발플랫폼을 바탕으로 메이저 업체와 협업 개발을 활발히 추진하고 있습니다.\n\n이들 사업부문의 연구개발 및 마케팅 업무는 국내에서 진행하고, 제조는 부품사업 성공에서 축적한 제조토탈솔루션을 기반으로 해외사업장(베트남, 인도네시아, 중국) 위주로 운영되고 있으며, 고부가제품은 국내라인을 셋업해서 성장시켜 가고자 합니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000944","hash":"e4877e8efecf3d6092cea34b36b9f2664c1bc306674b23319ec06ec6ccd36355"},"previous":{"fiscal_year":"2025","filed_at":"20260318","report":"사업보고서 (2025.12)","text":"가. 사업구분\n\n당사의 사업부문은 부품사업부문과 제품사업부문으로 구분되어 있습니다.부품사업부문은 휴대폰, Smart Watch, TWS 등에 들어가는 Module Ass'y, Speaker, Vibration Motor를 주력사업으로 추진하고 있고, 자동차용 전장메카, 햅틱 모듈 분야로 사업을 성장시켜 가고 있습니다.\n\n제품사업부문은 전자담배, 자동주사기의 2개 분야 사업을 추진하고 있으며 지적재산권을 확보한 자사개발플랫폼을 바탕으로 메이저 업체와 협업 개발을 활발히 추진하고 있습니다.\n\n이들 사업부문의 연구개발 및 마케팅 업무는 국내에서 진행하고, 제조는 부품사업 성공에서 축적한 제조토탈솔루션을 기반으로 해외사업장(베트남, 인도네시아, 중국) 위주로 운영되고 있으며, 고부가제품은 국내라인을 셋업해서 성장시켜 가고자 합니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000944","hash":"e4877e8efecf3d6092cea34b36b9f2664c1bc306674b23319ec06ec6ccd36355"},"added":[],"removed":[]},"employment_performance":{"status":"ready","employment":{"as_of":"202607","count":65.0,"previous_as_of":"202606","previous_count":68.0,"growth_pct"