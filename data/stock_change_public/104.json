하고 있으며, 반도체의 메모리(DRAM, NAND), 비메모리, 디스플레이의 OLED, LCD를 생산하는 과정에서의 소재로 사용되고 있습니다. 당사의 종속회사는 연구 및 해외영업을 목적으로한 미국법인(WMNA) 1개사와 국내법인과 동일한 사업목적의 중국법인(신원익, 위남원익) 2개사가 있습니다.","truncated":false,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000451","hash":"a951d1af68102a92420743822956dbc12cb516a402369849a02943ae9f11fc8b"},"previous":null,"added":[],"removed":[]},"employment_performance":{"status":"ready","employment":{"as_of":"202607","count":507.0,"previous_as_of":"202606","previous_count":508.0,"growth_pct":-0.2,"hire":2.0,"leave":7.0,"net":-5.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":2025,"previous_as_of":2024,"revenue":322467412745.0,"revenue_previous":310715204992.0,"revenue_growth_pct":3.8,"operating_profit":56497808201.0,"operating_profit_previous":51919490369.0,"operating_profit_growth_pct":8.8,"source":"DART 연간 재무"},"relationship":"mixed_direction","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"no_record","events":[],"event_total":0,"instruments":[],"dilution_pct":null,"note":"공시 제목 분류 이력이며 현재 잔존 물량 확정값이 아니다."},"coverage":{"hit":4,"total":6,"fields":{"daily_pair":true,"business_report":true,"business_previous":false,"employment":true,"financial_pair":true,"capital_history":false}}},"104700":{"ticker":"104700","name":"한국철강","market":"KOSPI","today":{"status":"changed","as_of":"2026-08-25","previous_as_of":"2026-08-24","fields":[{"key":"price","label":"가격","before":9850.0,"after":9880.0,"delta":30.0,"delta_pct":0.3},{"key":"market_cap","label":"시가총액","before":311672078336.0,"after":312621334528.0,"delta":949256192.0,"delta_pct":0.3},{"key":"per","label":"PER","before":15.11,"after":15.15,"delta":0.04,"delta_pct":0.26}],"source":"data/stock_history 일별 스냅샷","disclosures":[]},"business_report":{"status":"baseline","current":{"fiscal_year":"2025","filed_at":"20260319","report":"사업보고서 (2025.12)","text":"당사는 120톤 전기로 및 압연설비를 통하여 철근을 생산하여 건설사, 유통상, 조달청등에 판매하는 단일의 영업부문으로 이루어져 있습니다. 국내 건설업 경기 악화와 원자재 가격변동이 심화되어 경영상 리스크가 