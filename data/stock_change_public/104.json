8736445440.0,"after":37046374400.0,"delta":-1690071040.0,"delta_pct":-4.36}],"source":"data/stock_history 일별 스냅샷","disclosures":[]},"business_report":{"status":"baseline","current":{"fiscal_year":"2025","filed_at":"20260814","report":"[기재정정]사업보고서 (2025.12)","text":"당사는 수익을 창출하는 서비스를 제공받는 고객의 유형 및 사업부문 구분의 계속성 등을 고려하여 B2B와 B2C로 구분하고 있습니다. 2025년 손익계산서 기준 매출액은 44,899백만원이며 각 사업부문별 매출액 비중은 B2C 약 44%. B2B 약 56%입니다.\n\nB2C 사업부문에는 '벅스(Bugs!)', '에센셜(essential;)', '세이캐스트(SayCast)' 등의 사업이 있으며 '벅스'는 인터넷사이트 및 모바일 기기를 통해 음원을 스트리밍 또는 다운로드할 수 있는 서비스를 제공하는 음원 플랫폼 사업, '에센셜'은 다양한 프로모션 사업을 진행하는 음악 큐레이션 브랜드 운영 사업, 그리고 '세이캐스트'는 온라인 채팅 서비스를 기반으로 한 음악 방송 SNS 운영 사업입니다.\n\nB2B 부문에는 음원유통서비스 사업이 있으며, 음원유통서비스 사업은 음원 제작에 투자하여 일정기간 해당 음원의 유통에 관한 독점적 권리를 보장받고 이를 B2C 서비스업체에게 판매하여 서비스할 수 있도록 하는 사업입니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260814000419","hash":"f76512ac0d5bfedb5efd77c9c274d30816e6fc5c05245bd4f392449c55f12bcf"},"previous":null,"added":[],"removed":[]},"employment_performance":{"status":"partial","employment":{"as_of":"202607","count":null,"previous_as_of":null,"previous_count":null,"growth_pct":null,"hire":null,"leave":null,"net":null,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":2025,"previous_as_of":2024,"revenue":44899287200.0,"revenue_previous":52070939126.0,"revenue_growth_pct":-13.8,"operating_profit":-734987723.0,"operating_profit_previous":357425932.0,"operating_profit_growth_pct":-305.6,"source":"DART 연간 재무"},"relationship":"insufficient","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"ready","events":[{"date":"2021-11-29","category":"자기주식처분","title":"주요사항보고서(자기주식처분결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20211129001017"},{"date":"2015-06-26","category":"유상증자","title":"[기재정정]주요사항보고서(유상증자결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20150626000067"},{"date":"2015-05-20","category":"유상증자","title":"[기재정정]주요사항보고서(유상증자결정)","is_