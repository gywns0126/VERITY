or Deposition; 화학증착) 증착방식이 사용됩니다. 당사는 이 CVD 장비 중에서 플라즈마를 활용한 장비인 PECVD(Plasma Enhanced Chemical Vapor Deposition) 장비에 장착이 되는 핵심적인 소모성 부품을 제작 및 가공, 표면처리하여 고객사에 납품하고 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001054","hash":"4086160336184b3c68bd9c2935dddbac76de97f79a520eefb6eba0ba0bc00f8b"},"added":[],"removed":[]},"employment_performance":{"status":"ready","employment":{"as_of":"202606","count":172.0,"previous_as_of":null,"previous_count":null,"growth_pct":null,"hire":2.0,"leave":4.0,"net":-2.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":2025,"previous_as_of":2024,"revenue":35964832400.0,"revenue_previous":31012488636.0,"revenue_growth_pct":16.0,"operating_profit":832014951.0,"operating_profit_previous":-1307393171.0,"operating_profit_growth_pct":163.6,"source":"DART 연간 재무"},"relationship":"insufficient","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"ready","events":[{"date":"2019-09-03","category":"자기주식처분","title":"주요사항보고서(자기주식처분결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20190903000046"}],"event_total":1,"instruments":[],"dilution_pct":null,"note":"공시 제목 분류 이력이며 현재 잔존 물량 확정값이 아니다."},"coverage":{"hit":5,"total":6,"fields":{"daily_pair":false,"business_report":true,"business_previous":true,"employment":true,"financial_pair":true,"capital_history":true}}},"256150":{"ticker":"256150","name":"한독크린텍","market":"KOSDAQ","today":{"status":"insufficient_history","as_of":"","previous_as_of":null,"fields":[],"disclosures":[]},"business_report":{"status":"unchanged","current":{"fiscal_year":"2025","filed_at":"20260317","report":"사업보고서 (2025.12)","text":"당사는 정수기 필터 제조 및 판매 등을 주 영업목적으로 2003년 11월 26일에 설립되었으며, 모든 정수기에 필수적으로 적용되고 있는 카본블록필터를 제조하는 전문업체로서, 주요 제품으로는 카본블록필터와 복합필터 등이 있습니다.당사는 2017년 하반기부터 자동 생산라인을 구축하기 위해 설비투자를 진행하였으며, 공시서류 작성기준일 현재 6개의 반자동 생산라인 및 4개의 자동 생산라인을 보유하고 있습니다. 자동 라인은 기존의 반자동 라인에 비해 필터 단위당 생산시간이 축소되고 24시간 가동이 가능하여, 라인 운용 인력이 축소되고 원재료 Loss의 감소 등으로 생산능력 증가와 동시에 인건비 절감을 가능케 합니다. 당사는 국내 주요 정수기 제조사인 코웨이, LG전자, SK매직, 교원, 쿠쿠홈시스, 삼성전자 등에 필터를 공급하고 있으며, 공시서류 작성기준일 현재 당사의 매출은 대부분 정수기 필터 매출로 이루어지고 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000700","hash":"a65cf3d166368fbd8fa1de81f1a0c6fa67637e5a96fd27270e66e03bb4561f03"},"previous":{"fiscal_year":"2025","filed_at":"20260317","report":"사업보고서 (2025.12)","text":"당사는 정수기 필터 제조 및 판매 등을 주 영업목적으로 2003년 11월 26일에 설립되었으며, 모든 정수기에 필수적으로 적용되고 있는 카본블록필터를 제조하는 전문업체로서, 주요 제품으로는 카본블록필터와 복합필터 등이 있습니다.당사는 2017년 하반기부터 자동 생산라인을 구축하기 위해 설비투자를 진행하였으며, 공시서류 작성기준일 현재 6개의 반자동 생산라인 및 4개의 자동 생산라인을 보유하고 있습니다. 자동 라인은 기존의 반자동 라인에 비해 필터 단위당 생산시간이 축소되고 24시간 가동이 가능하여, 라인 운용 인력이 축소되고 원재료 Loss의 감소 등으로 생산능력 증가와 동시에 인건비 절감을 가능케 합니다. 당사는 국내 주요 정수기 제조사인 코웨이, LG전자, SK매직, 교원, 쿠쿠홈시스, 삼성전자 등에 필터를 공급하고 있으며, 공시서류 작성기준일 현재 당사의 매출은 대부분 정수기 필터 매출로 이루어지고 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000700","hash":"a65cf3d166368fbd8fa1de81f1a0c6fa67637e5a96fd27270e66e03bb4561f03"},"added":[],"removed":[]},"employment_performance":{"status":"partial","employment":{"as_of":"202606","count":null,"previous_as_of":null,"previous_count":null,"growth_pct":null,"hire":null,"leave":null,"net":null,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":null,"previous_as_of":null,"revenue":null,"revenue_previous":null,"revenue_growth_pct":null,"operating_profit":null,"operating_profit_previous":null,"operating_profit_growth_pct":null,"source":"DART 연간 재무"},"relationship":"insufficient","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"ready","events":[{"date":"2021-03-31","category":"자기주식처분","title":"주요사항보고서(자기주식처분결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20210331002698"},{"date":"2020-04-03","category":"자기주식처분","title":"[기재정정]주요사항보고서(자기주식처분결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20200403003004"},{"date":"2020-03-05","category":"자기주