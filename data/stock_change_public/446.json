여 복잡한 기계 가공작업을 면이나 측면의 파열 없이 수행할 수 있습니다. 국내산 목재를 주원료로 사용하는 당사 MDF는 친환경적이며, 우수한 물성과 가공성을 지녔습니다. 또한, 직경이 작고 굴곡이 많아 활용도가 낮은 국내산 목재를 사용함으로써 우리나라 목재 자급률 제고에 중요한 역할을 하고 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001647","hash":"1fa277fcd0fdc4f3ae16ce355dd14db2e7a24fc31ec57ab7f59d0068389f5a4d"},"previous":null,"added":[],"removed":[]},"employment_performance":{"status":"ready","employment":{"as_of":"202607","count":200.0,"previous_as_of":null,"previous_count":null,"growth_pct":null,"hire":1.0,"leave":3.0,"net":-2.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":2025,"previous_as_of":2024,"revenue":157531389366.0,"revenue_previous":194894088152.0,"revenue_growth_pct":-19.2,"operating_profit":-9151579966.0,"operating_profit_previous":3054336971.0,"operating_profit_growth_pct":-399.6,"source":"DART 연간 재무"},"relationship":"insufficient","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"ready","events":[{"date":"2025-12-18","category":"자기주식처분","title":"[기재정정]주요사항보고서(자기주식처분결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20251218000394"},{"date":"2025-12-12","category":"자기주식처분","title":"주요사항보고서(자기주식처분결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20251212000533"},{"date":"2025-10-01","category":"자기주식처분","title":"주요사항보고서(자기주식처분결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20251001000516"},{"date":"2024-12-23","category":"자기주식처분","title":"주요사항보고서(자기주식처분결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20241223000385"}],"event_total":4,"instruments":[],"dilution_pct":null,"note":"공시 제목 분류 이력이며 현재 잔존 물량 확정값이 아니다."},"coverage":{"hit":4,"total":6,"fields":{"daily_pair":false,"business_report":true,"business_previous":false,"employment":true,"financial_pair":true,"capital_history":true}}}}}