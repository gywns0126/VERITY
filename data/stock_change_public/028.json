elta":150.0,"delta_pct":0.42},{"key":"market_cap","label":"시가총액","before":4783528738816.0,"after":4730378518528.0,"delta":-53150220288.0,"delta_pct":-1.11}],"source":"data/stock_history 일별 스냅샷","disclosures":[]},"business_report":{"status":"unchanged","current":{"fiscal_year":"2025","filed_at":"20260323","report":"사업보고서 (2025.12)","text":"(1) 산업의 특성(가) 체외진단 의료기기 및 의약외품\n\n체외진단의료기기와 의약외품과 같은 헬스케어 & 바이오산업은 상대적으로 보다 높은 고부가가치를 창출할 수 있는 지식기반산업으로서 차세대 성장동력산업의 하나로주목받고 있습니다. 이는 생명공학기술이 정보통신기술(IT)이나 나노기술(NT) 등의 첨단기술과 함께 향후 산업 혁신에 있어서 매우 폭넓고 다양하게 기여할 것으로 예상하기 때문이며, 이러한 생명공학기술을 활용하여 인체 적합성이 강화된 의약품 및 의료기기를 개발할 수도 있으며 사용되는 원료의 재활용도를 높일 수 있을 뿐 아니라 친환경제품의 개발도 가능한 산업 분야입니다. 이러한 헬스케어 & 바이오산업은 다가오는 고령화 및 보건, 식량, 환경, 에너지 등 인류가 직면하고 있는 각종 문제점을 해결할 수 있는 미래 산업이라 할 수 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001673","hash":"45f8d3e3d70e2416404a8a5a7e20442c5694ad8e598afdc50298785b8a14b3a3"},"previous":{"fiscal_year":"2025","filed_at":"20260323","report":"사업보고서 (2025.12)","text":"(1) 산업의 특성(가) 체외진단 의료기기 및 의약외품\n\n체외진단의료기기와 의약외품과 같은 헬스케어 & 바이오산업은 상대적으로 보다 높은 고부가가치를 창출할 수 있는 지식기반산업으로서 차세대 성장동력산업의 하나로주목받고 있습니다. 이는 생명공학기술이 정보통신기술(IT)이나 나노기술(NT) 등의 첨단기술과 함께 향후 산업 혁신에 있어서 매우 폭넓고 다양하게 기여할 것으로 예상하기 때문이며, 이러한 생명공학기술을 활용하여 인체 적합성이 강화된 의약품 및 의료기기를 개발할 수도 있으며 사용되는 원료의 재활용도를 높일 수 있을 뿐 아니라 친환경제품의 개발도 가능한 산업 분야입니다. 이러한 헬스케어 & 바이오산업은 다가오는 고령화 및 보건, 식량, 환경, 에너지 등 인류가 직면하고 있는 각종 문제점을 해결할 수 있는 미래 산업이라 할 수 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001673","hash":"45f8d3e3d70e2416404a8a5a7e20442c5694ad8e598afdc50298785b8a14b3a3"},"added":[],"removed":[]},"employment_performance":{"status":"partial","employment":{"as_of":"202607","count":null,"previous_as_of":null,"previous_count":null,"growth_pct":null,"hire":null,"leave":null,"net":null,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":2025,"previous_as_of":2024,"revenue":84172574224.0,"revenue_previous":68125727347.0,"revenue_growth_pct":23.6,"operating_profit":-104217336541.0