382256840704.0,"delta":-5560958976.0,"delta_pct":-1.43},{"key":"per","label":"PER","before":8.99,"after":8.86,"delta":-0.13,"delta_pct":-1.45}],"source":"data/stock_history 일별 스냅샷","disclosures":[]},"business_report":{"status":"unchanged","current":{"fiscal_year":"2025","filed_at":"20260317","report":"사업보고서 (2025.12)","text":"카페24와 종속회사는 전 세계 전자상거래 시장에서 온라인 비즈니스를 영위하길 원하는 '판매자'를 대상으로 원스톱 이커머스 솔루션과 서비스를 제공하는 IT 플랫폼 기업입니다. 일반적인 전자상거래 마켓 플레이스 기업은 물건을 구매하는 소비자가 고객인 반면, 당사는 독립적인 온라인 쇼핑몰 혹은 다양한 마켓 플레이스에서 유ㆍ무형의 재화를 판매하는 판매자가 고객입니다.\n\n당사는 1999년 설립 후 2002년 IT 인프라(호스팅) 사업을 시작으로 2003년 전자상거래 솔루션 시장에 진출하였습니다. 판매자가 직접 소비자에게 온라인 판매를 할 수 있는 D2C 스토어를 구축하는 솔루션을 무료로 제공하고 다양한 부가서비스를 연결해 시장을 선점하며 지배적인 이커머스 플랫폼 기업으로 자리매김하였습니다.\n\n당사의 플랫폼은 온라인 쇼핑몰을 운영하는 1인 창업자부터 인플루언서, 중대형 기업 등 약 200만 곳의 폭넓은 고객층이 이용하고 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000899","hash":"76f6d45e28b1628a28f725f6f5adc4e73488373330eaa284f93fd78c4335a58a"},"previous":{"fiscal_year":"2025","filed_at":"20260317","report":"사업보고서 (2025.12)","text":"카페24와 종속회사는 전 세계 전자상거래 시장에서 온라인 비즈니스를 영위하길 원하는 '판매자'를 대상으로 원스톱 이커머스 솔루션과 서비스를 제공하는 IT 플랫폼 기업입니다. 일반적인 전자상거래 마켓 플레이스 기업은 물건을 구매하는 소비자가 고객인 반면, 당사는 독립적인 온라인 쇼핑몰 혹은 다양한 마켓 플레이스에서 유ㆍ무형의 재화를 판매하는 판매자가 고객입니다.\n\n당사는 1999년 설립 후 2002년 IT 인프라(호스팅) 사업을 시작으로 2003년 전자상거래 솔루션 시장에 진출하였습니다. 판매자가 직접 소비자에게 온라인 판매를 할 수 있는 D2C 스토어를 구축하는 솔루션을 무료로 제공하고 다양한 부가서비스를 연결해 시장을 선점하며 지배적인 이커머스 플랫폼 기업으로 자리매김하였습니다.\n\n당사의 플랫폼은 온라인 쇼핑몰을 운영하는 1인 창업자부터 인플루언서, 중대형 기업 등 약 200만 곳의 폭넓은 고객층이 이용하고 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000899","hash":"76f6d45e28b1628a28f725f6f5adc4e73488373330eaa284f93fd78c4335a58a"},"added":[],"removed":[]},"employment_performance":{"status":"ready","employment":{"as_of":"202607","count":948.0,"previous_as_of":"202606","previous_count":953.0,"growth_pct":-0.5,"hire":4.0,"leave":13.0,"net":-9.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":2025,"previous_as_of":2024,"revenue":314764225560.0,"reven