어 있고 이러한 단품들을 당사의 CID 조립장비를 통해 조립/생산되고 있습니다.\n\n46파이 배터리는 차세대 메인스트림으로 부상하고 있는 폼팩터로, 현재 미국계 글로벌 전기차 기업이 관련 시장을 주도하고 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000840","hash":"f275468f4047678b71e414f366d069686d37de818dcfd8b972f9d3d18701cdf4"},"previous":null,"added":[],"removed":[]},"employment_performance":{"status":"ready","employment":{"as_of":"202607","count":5.0,"previous_as_of":"202606","previous_count":4.0,"growth_pct":25.0,"hire":1.0,"leave":0.0,"net":1.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":2025,"previous_as_of":2024,"revenue":41230345116.0,"revenue_previous":26955762199.0,"revenue_growth_pct":53.0,"operating_profit":-1564000608.0,"operating_profit_previous":807640617.0,"operating_profit_growth_pct":-293.7,"source":"DART 연간 재무"},"relationship":"mixed_direction","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"ready","events":[{"date":"2025-09-04","category":"전환사채(CB)","title":"[기재정정]주요사항보고서(전환사채권발행결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20250904000437"},{"date":"2025-09-03","category":"전환사채(CB)","title":"주요사항보고서(전환사채권발행결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20250903000155"}],"event_total":2,"instruments":[{"type":"CB","bond_kind":"2","issue_amount":10000000000,"strike":null,"issuable_shares":877192,"resolved_date":"2025년 09월 03일"}],"dilution_pct":10.0,"note":"DART 주요사항보고 발행 기준(전환·상환 미반영) · 희석률=발행가능÷발행주식"},"coverage":{"hit":5,"total":6,"fields":{"daily_pair":true,"business_report":true,"business_previous":false,"employment":true,"financial_pair":true,"capital_history":true}}},"432320":{"ticker":"432320","name":"KB스타리츠","market":"KOSPI","today":{"status":"changed","as_of":"2026-08-27","previous_as_of":"2026-08-26","fields":[{"key":"price","label":"가격","before":1429.0,"after":1414.0,"delta":-15.0,"delta_pct":-1.05},{"key":"market_cap","label":"시가총액","before":157886693376.0,"after":156229386240.0,"delta":-1657307136.0,"delta_pct":-1.05},{"key":"shares_outstanding","label":"발행주식수","before":110487540.0,"after":110487541.0,"delta":1.0,"delta_pct":0.0}],"source":"data/stock_history 일별 스냅샷","disclosures":[]},"business_report":{"status":"baseline","current":{"fiscal_year":"2025","filed_at":"20260512","report":"[기재정정]사업보고서 (2026.01)","text":"가. 부동산투사회사(리츠) 산업의 특성\n\n 부동산투자회사(이하 “리츠”)는 부동산투자회사법에 따라 다수의 투자자로부터 자금을 모아 부동산, 부동산 관련 증권등에 투자, 운용하고 그 수익을 투자자에게 돌려주는 부동산 간접투자기구인 주식회사입니다. 리츠는 1960년 미국에서 최초 도입 되었으며, 한국에는 1997년 외환위기 이후 기업들의 보유 부동산 유동화를 통한 기업구조조정을 촉진하기 위해 2001년 처음 도입되었습니다. 이후 리츠의 투자물건이 기업 구조조정 부동산에서 점차 일반 부동산으로 변화하였습니다. 다만 기관투자자 중심의 비상장리츠를 벗어나지 못하여, 일반 국민이 리츠를 통하여 부동산에 투자할 수 있는 기회는 제한적이었습니다. 2018년 12월 정부의 리츠 공모 상장 활성화 방안 발표를 기점으로 공모상장리츠가 지속적으로 출시되었고, 이후에도 추가적인 공모상장리츠가 예정되어 있어, 일반 국민의 리츠투자 기회가 지속적으로 확대될 것으로 기대하고 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260512000411","hash":"c09cc4e1162030d7dd02d763d47eef0f795b4ce3f8ad46c50b3d633208863afd"},"previous":null,"added":[],"removed":[]},"employment_performance":{"status":"partial","employment":{"as_of":"202607","count":null,"previous_as_of":null,"previous_count":null,"growth_pct":null,"hire":null,"leave":null,"net":null,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":2025,"previous_as_of":2024,"revenue":30393926136.0,"revenue_previous":29781181411.0,"revenue_growth_pct":2.1,"operating_profit":-72447633526.0,"operating_profit_previous":-26837382721.0,"operating_profit_growth_pct":-170.0,"source":"DART 연간 재무"},"relationship":"insufficient","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"ready","events":[{"date":"2026-04-13","category":"유상증자","title":"[기재정정]주요사항보고서(유상증자결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260413001502"},{"date":"2026-03-09","category":"유상증자","title":"[기재정정]주요사항보고서(유상증자결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260309001319"},{"date":"2026-02-20","category":"유상증자","title":"주요사항보고서(유상증자결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260220002298"}],"event_total":3,"instruments":[],"dilution_pct":null,"note":"공시 제목 분류 이력이며 현재 잔존 물량 확정값이 아니다."},"coverage":{"hit":4,"total":6,"fields":{"daily_pair":true,"business_report":true,"business_previous":false,"employment":false,"financial_pair":true,"capital_history":true}}},"432980":{"ticker":"432980","name":"엠에프씨","market":"KOSDAQ","today":{"status":"insufficient_history","as_of":"","previous_as_of":null,"fields":[],"disclosures":[]},"business_report":{"status":"baseline","current":{"fiscal_year":"2025","filed_at":"20260323","report":"사업보고서 (2025.12)","text":"가. 사업의 개요\n\n당사는 원료의약품/소재개발 및 제조 전문 회사로, 유기합성 및 대량생산 기술, 신규결정화 기술 등 다양한 기반기술을 활용하여 의약품의 활성 성분인 원료의약품(Active Pharmaceutical Ingredient, API)을 비롯하여 이를 생산하기 위한 핵심출발소재(Key Starting Material, KSM), 중간소재(Pharmaceutical Ingredient, PI) 등을 전문적으로 개발 및 양산하고 있습니다.\n\n당사는 일반적인 의약품 생산단계 중 \"핵심출발소재(KSM) 및 중간소재(PI), 원료의약품(API)\"의 범주에 해당하는 물질들을 대상으로 합성/정제에 관한 연구개발 및 상업화 생산을 주력으로 하고 있습니다. 또한 당사의 제품은 이미 시판되고 있는 \"승인된 오리지널 의약품 또는 제네릭 의약품\"만을 대상으로 하는 것이 아니라, 개발 단계에 있는 \"신약 또는 개량신약원료\"까지도 대상으로 삼고 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000972","hash":"bb5af7f2e5eb18efef8d5cfb91f6c4e332b8a09bdf8dd501174229ed49ce9f2a"},"previous":null,"added":[],"removed":[]},"employment_performance":{"status":"partial","employment":{"as_of":"202607","count":120.0,"previous_as_of":null,"previous_count":null,"growth_pct":null,"hire":4.0,"leave":1.0,"net":3.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":null,"previous_as_of":null,"revenue":null,"revenue_previous":null,"revenue_growth_pct":null,"operating_profit":null,"operating_profit_previous":null,"operating_profit_growth_pct":null,"source":"DART 연간 재무"},"relationship":"insufficient","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"no_record","events":[],"event_total":0