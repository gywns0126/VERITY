nt_total":1,"instruments":[],"dilution_pct":null,"note":"공시 제목 분류 이력이며 현재 잔존 물량 확정값이 아니다."},"coverage":{"hit":5,"total":6,"fields":{"daily_pair":true,"business_report":true,"business_previous":false,"employment":true,"financial_pair":true,"capital_history":true}}},"388210":{"ticker":"388210","name":"씨엠티엑스","market":"KOSDAQ","today":{"status":"changed","as_of":"2026-08-27","previous_as_of":"2026-08-26","fields":[{"key":"price","label":"가격","before":73200.0,"after":75000.0,"delta":1800.0,"delta_pct":2.46},{"key":"market_cap","label":"시가총액","before":700153462784.0,"after":717370359808.0,"delta":17216897024.0,"delta_pct":2.46},{"key":"per","label":"PER","before":8.55,"after":8.76,"delta":0.21,"delta_pct":2.46}],"source":"data/stock_history 일별 스냅샷","disclosures":[]},"business_report":{"status":"baseline","current":{"fiscal_year":"2025","filed_at":"20260323","report":"사업보고서 (2025.12)","text":"사업에 대한 이해를 돕기 위해 당사가 영위하는 사업 분야 및 기술, 제품에 대한 전문용어 해설을 아래 표와 같이 기재합니다.\n\n[용어의 정의]\n\n용어\n\n내용\n\n반도체 소자(素子)\n\n반도체를 소재로 하여 만든 회로소자로서, 여기에 사용되는 반도체는 규소, 저마늄, 갈륨비소 등이 있습니다.\n\n실리콘(Si)\n\n일반적으로 산화물인 SiO2의 형태로 모래, 암석, 광석 등으로 존재하며, 반도체 재료로 활용하기 위해서는 지각에 산재해 있는 실리콘 소재를 정제하여 사용함. 동 소재는 반도체산업에서 다양한 형태로 이용되며, 보통 식각(Etching) 공정에 많이 사용됩니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000962","hash":"bb13666c47d99d1bc1304986d8554a2eb0ccde5efdfcb53da1ecd77a7087b844"},"previous":null,"added":[],"removed":[]},"employment_performance":{"status":"partial","employment":{"as_of":"202607","count":314.0,"previous_as_of":"202606","previous_count":295.0,"growth_pct":6.4,"hire":28.0,"leave":9.0,"net":19.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":null,"previous_as_of":null,"revenue":null,"revenue_previous":null,"revenue_growth_pct":null,"operating_profit":null,"operating_profit_previous":null,"operating_profit_growth_pct":null,"source":"DART 연간 재무"},"relationship":"insufficient","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"no_record","events":[],"event_total":0,"instruments":[],"dilution_pct":null,"note":"공시 제목 분류 이력이며 현재 잔존 물량 확정값이 아니다."},"coverage":{"hit":3,"total":6,"fields":{"daily_pair":true,"business_report":true,"business_previous":false,"employment":true,"financial_pair":false,"capital_history":false}}},"388720":{"ticker":"388720","name":"유일로보틱스","market":"KOSDAQ","today":{"status":"changed","as_of":"2026-08-27","previous_as_of":"2026-08-26","fields":[{"key":"price","label":"가격","before":67000.0,"after":68500.0,"delta":1500.0,"delta_pct":2.24},{"key":"market_cap","label":"시가총액","before":789350121472.0,"after":807022100480.0,"delta":17671979008.0,"delta_pct":2.24}],"source":"data/stock_history 일별 스냅샷","disclosures":[]},"business_report":{"status":"baseline","current":{"fiscal_year":"2025","filed_at":"20260318","report":"사업보고서 (2025.12)","text":"가. 산업의 특성 \n\n당사의 사업은 자동화 시스템 및 산업용 로봇 관련 산업의 범주 내에 속해 있으며, 해당 산업은 아래와 같은 3가지 사유로 향후 성장 잠재력이 매우 높을 것이라 판단하고있습니다.첫째, 제조업의 인력 부족과 원가상승 등으로 공장자동화의 지속적인 수요가 발생할 것으로 기대됩니다.둘째, 제조용 로봇 분야의 전방산업은 자동차, 전자, 조선 등 대형제조업 뿐만 아니라컴퓨터, 스마트폰 등 전방위적인 제조 산업과 관련성이 있어 특정 산업의 경기 변동에 영향을 받을 가능성이 낮습니다.셋째, 품질 안전성과 생산력 향상을 도모하는 제조현장의 상황에 맞는 공장자동화의 효율성 추구와 맞물려 수요는 더욱 증가될 것으로 전망됩니다.\n\n \n\n나. 사업의 현황 및 전망 \n\n당사는 산업용 로봇 및 사출성형에 적용되는 사출주변기기(스마트기기)의 제조와 판매 및 오토피딩(Auto-Feeding)시스템과 냉각시스템 등을 통한 자동화 시스템을 주요사업으로 영위하고 있습니다. 플라스틱 사출 자동화 시스템은 자동차, 의료기기, 2차전지, 가전제품, 일반 소비재, 포장재 등 다양한 제조산업에 두루 적용되고 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000929","hash":"8f000007b7350a4367bd8000052cdfe94a4f7017a45ff797f1e29cfd0c0904a4"},"previous":null,"added":[],"removed":[]},"employment_performance":{"status":"ready","employment":{"as_of":"202607","count":274.0,"previous_as_of":"202606","previous_count":273.0,"growth_pct":0.4,"hire":4.0,"leave":7.0,"net":-3.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":2025,"previous_as_of":2024,"revenue":36917751388.0,"revenue_previous":35168850105.0,"revenue_growth_pct":5.0,"operating_profit":-12620478623.0,"operatin