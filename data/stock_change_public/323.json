fter":56500.0,"delta":-2200.0,"delta_pct":-3.75},{"key":"market_cap","label":"시가총액","before":1792579469312.0,"after":1725395894272.0,"delta":-67183575040.0,"delta_pct":-3.75}],"source":"data/stock_history 일별 스냅샷","disclosures":[]},"business_report":{"status":"unchanged","current":{"fiscal_year":"2025","filed_at":"20260323","report":"사업보고서 (2025.12)","text":"당사는 한국표준산업분류상 그 외 기타 특수 목적용 기계 제조업(C29299)에 속하는 회사로, 전자소재 및 전자부품 제조 공정에 사용되는 장비를 생산 및 공급하고 있습니다. 당사의 사업은 PCB 제조 공정 자동화 장비를 기반으로 하여 글래스 기판 제조공정 장비 및 2차전지 소재 제조 공정 장비 등 전자소재 제조 공정 장비 분야로 확대되고 있습니다.\n\n당사의 사업영역\n\n(출처: 당사자료)현재 당사의 주요 사업은 PCB 제조 공정 장비, 글래스 기판 제조 공정 장비 및 2차전지 소재 제조 공정 장비로 구분됩니다. PCB 제조 공정 장비는 당사의 기존 주력 사업으로 PCB 생산 공정에 사용되는 식각, 표면처리 등 습식(Wet) 공정 장비 및 자동화 장비를 중심으로 다양한 장비를 개발 및 생산하고 있으며, PCB 제조 공정에 필요한 습식 장비를 국내외 PCB 제조업체에 공급하고 있습니다. 또한 장비 제작 사업 외에도 PCB 외주 생산 및 PCB 생산 공정에 사용되는 세라믹 브러시 등 공정 소모품 판매하고 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000642","hash":"b57913c58c927168c3c312460aea9f1259d435508bc3d730a60c7cde4609ac2d"},"previous":{"fiscal_year":"2025","filed_at":"20260323","report":"사업보고서 (2025.12)","text":"당사는 한국표준산업분류상 그 외 기타 특수 목적용 기계 제조업(C29299)에 속하는 회사로, 전자소재 및 전자부품 제조 공정에 사용되는 장비를 생산 및 공급하고 있습니다. 당사의 사업은 PCB 제조 공정 자동화 장비를 기반으로 하여 글래스 기판 제조공정 장비 및 2차전지 소재 제조 공정 장비 등 전자소재 제조 공정 장비 분야로 확대되고 있습니다.\n\n당사의 사업영역\n\n(출처: 당사자료)현재 당사의 주요 사업은 PCB 제조 공정 장비, 글래스 기판 제조 공정 장비 및 2차전지 소재 제조 공정 장비로 구분됩니다. PCB 제조 공정 장비는 당사의 기존 주력 사업으로 PCB 생산 공정에 사용되는 식각, 표면처리 등 습식(Wet) 공정 장비 및 자동화 장비를 중심으로 다양한 장비를 개발 및 생산하고 있으며, PCB 제조 공정에 필요한 습식 장비를 국내외 PCB 제조업체에 공급하고 있습니다. 또한 장비 제작 사업 외에도 PCB 외주 생산 및 PCB 생산 공정에 사용되는 세라믹 브러시 등 공정 소모품 판매하고 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000642","hash":"b57913c58c927168c3c312460aea9f1259d435508bc3d730a60c7cde4609ac2d"},"added":[],"removed":[]},"employment_performance":{"status":"ready","employment":{"as_of":"202608","count":3.0,"previous_as_of":"202607","previous_count":3.0,"growth_pct":0.0,"hire":0.0,"lea