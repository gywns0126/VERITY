ous":false,"employment":false,"financial_pair":false,"capital_history":true}}},"101160":{"ticker":"101160","name":"월덱스","market":"KOSDAQ","today":{"status":"changed","as_of":"2026-08-27","previous_as_of":"2026-08-26","fields":[{"key":"price","label":"가격","before":28950.0,"after":29250.0,"delta":300.0,"delta_pct":1.04},{"key":"market_cap","label":"시가총액","before":477993238528.0,"after":482946547712.0,"delta":4953309184.0,"delta_pct":1.04}],"source":"data/stock_history 일별 스냅샷","disclosures":[]},"business_report":{"status":"baseline","current":{"fiscal_year":"2025","filed_at":"20260318","report":"사업보고서 (2025.12)","text":"당사의 사업분야는 반도체 등의 제조공정에 투입되는 실리콘 부품(Silicon Parts)사업, 쿼츠 부품(Quartz Parts) 사업 및 실리콘, 쿼츠 이외는 ALN, SiC 등의 소재로 제작되는 파인세라믹(Fine Ceramic) 사업으로 구성되어 있습니다. 당사의 제품은 주로 반도체 에칭(Etching) 공정에서 반도체 수율에 직접적인 영향을 주는 핵심 부품으로 최근 반도체 공정의 미세화로 중요성이 더욱 강조되고 있습니다.\n\n구 분\n\n주요 제품\n\nSilicon 제품\n\nElectrode, Cathode, Shower Head, Ring, Disk, Silicon Ingot 등\n\nQuartz 제품\n\nFocus Ring, 2단 Ring, Tube, Boat \n\nFine Ceramic 제품\n\nSiC Ring, SiC Chuck, SiC Arm, ALN Parts, Alumina Parts 등\n\n월덱스의 주요 사업 영역\n\n2025년 당사의 매출(연결기준)은 2,918억원으로 직전 사업연도(2024년) 대비 4.9% 감소하였으며, 영업이익률은 20.1%를 시현하였습니다.","truncated":false,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001643","hash":"18de813a8540f8451accc02692b37cd7bac2c55a29abed74536d50ebadd63c51"},"previous":null,"added":[],"removed":[]},"employment_performance":{"status":"ready","employment":{"as_of":"202607","count":435.0,"previous_as_of":"202606","previous_count":437.0,"growth_pct":-0.5,"hire":18.0,"leave":9.0,"net":9.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":2025,"previous_as_of":2024,"revenue":291764969976.0,"revenue_previous":306791365556.0,"revenue_growth_pct":-4.9,"operating_profit":58544362713.0,"operating_profit_previous":70304948252.0,"operating_profit_growth_pct":-16.7,"source":"DART 연간 재무"},"relationship":"same_direction","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"no_record","events":[],"event_total":0,"instruments":[],"dilution_pct":null,"note":"공시 제목 분류 이력이며 현재 잔존 물량 확정값이 아니다."},"coverage":{"hit":4,"total":6,"fields":{"daily_pair":true,"business_report":true,"business_previous":false,"employment":true,"financial_pair":true,"capital_history":false}}},"101400":{"ticker":"101400","name":"엔시트론","market":"KOSDAQ","today":{"status":"insufficient_history","as_of":"","previous_as_of":null,"fields":[],"disclosures":[]},"business_report":{"status":"baseline","current":{"fiscal_year":"2025","filed_at":"20260323","report":"사업보고서 (2025.12)","text":"연결실체(지배회사 및 연결대상 종속회사 [이하 \"회사\"])의 사업부문은 보고서 작성기준일 현재 반도체칩, 외식, 기타 부문으로 구분하고 있습니다.지배회사는 완전 디지털 오디오 앰프 솔루션 제품, 식음료, 미용기기 및 의료용 소모품 등의 판매사업을 총괄하고 있습니다. 종속회사 중 NF Industries Company Limited.는 완전 디지털 오디오 앰프 솔루션 제품의 판매 및 중국 현지 마케팅을 진행하고 있으며, 제이케이엔터프라이즈 주식회사는 \"고든램지\" 외식 브랜드를 운영하고 있습니다. 또한, 주식회사 고동컴퍼니는 \"고동경양\" 및 \"봉혜자네주방\" 브랜드 관련 외식가맹사업을 영위하고 있습니다. 아울러 주식회사 와이앤에이치메디는 미용기기 및 의료용 소모품 등을 판매하고 있습니다.2025년 기말 연결기준 매출액은 총 344억원으로 전년 동기 대비 약 5.4% 감소하였으며, 주요 매출처로는 Hisense, TCL 등이 있습니다.","truncated":false,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000929","hash":"1a82faf2909281bb4528a69c722567bb844b67cc3c7675f262046d9d37c91a23"},"previous":null,"added":[],"removed":[]},"employment_performance":{"status":"partial","employment":{"as_of":"202607","count":10.0,"previous_as_of":null,"previous_count":null,"growth_pct":null,"hire":0.0,"leave":0.0,"net":0.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":null,"previous_as_of":null,"revenue":null,"revenue_previous":null,"revenue_growth_pct":null,"operating_profit":null,"operating_profit_previous":null,"operating_profit_growth_pct":null,"source":"DART 연간 재무"},"relationship":"insufficient","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"ready","events":[{"date":"2026-08-13","category":"유상증자","title":"주요사항보고서(유상증자결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260813001235"}],"event_total":1,"instruments":[],"dilution_pct":null,"note":"공시 제목 분류 이력이며 현재 잔존 물량 확정값이 아니다."},"coverage":{"hit":3,"total":6,"fields":{"daily_pair":false,"business_report":true,"business_previous":false,"employment":true,"financial_pair":false,"capital_history":true}}},"101490":{"ticker":"101490","name":"에스앤에스텍","market":"KOSDAQ","today":{"status":"changed","as_of":"2026-08-27","previous_as_of":"2026-08-26","fields":[{"key":"price","label":"가격","before":42050.0,"after":42150.0,"delta":100.0,"delta_pct":0.24},{"key":"market_cap","label":"시가총액","before":884864516096.0,"after":886968877056.0,"delta":2104360960.0,"delta_pct":0.24}],"source":"data/stock_history 일별 스냅샷","disclosures":[]},"business_report":{"status":"baseline","current":{"fiscal_year":"2025","filed_at":"20260316","report":"사업보고서 (2025.12)","text":"당사는 대구광역시 및 경기도 용인시에 위치한 반도체ㆍ디스플레이 소재 전문 기업이며, 반도체(IC, Integrated Circuit) 및 디스플레이(FPD, Flat Panel Display)용 블랭크마스크(Blank Mask)를 생산ㆍ판매하고 있습니다.\n\n \n\n블랭크마스크는 반도체 웨이퍼에 회로를 새기기 위해 사용되는 포토마스크(Photo Mask)의 원재료로, 석영(쿼츠, Quartz) 기판 위에 금속막(크롬, Cr)과 감광액(Photo Resist, PR)을 도포하여 제조됩니다. 이후, 설계된 회로 패턴을 블랭크마스크에 형상화시켜 포토마스크를 완성하며, 노광 공정(Photo Lithography)을 통해 포토마스크에 빛을 통과시켜 반도체 웨이퍼에 회로를 새깁니다. 이처럼 블랭크마스크는 반도체 및 디스플레이 제조 공정의 핵심 재료로 평가됩니다.\n\n \n\n또한, 당사는 종속회사인 에스앤에스인베스트먼트 주식회사 및 주식회사 에스앤에스랩 등을 통해 신기술사업금융업과 바이오 및 과학기술 서비스업 등의 부가적인 사업도 영위하고 있습니다.\n\n \n\n아울러, 당사는 2025년(제25기) 연결 기준 매출액 2,437억 원을 기록하였습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316000487","hash":"8fa811c229ee14ee4c47fc12f41a3952f77cbabf8fd0868a2155cebbc99206e2"},"previous":null,"added":[],"removed":[]},"employment_performance":{"status":"ready","employment":{"as_of":"202607","count":350.0,"previous_as_of":"202606","previous_count":343.0,"growth_pct":2.0,"hire":11.0,"leave":1.0,"net":10.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":2025,"previous_as_of":2024,"revenue":243733252593.0,"revenue_previous":176013891367.0,"revenue_growth_pct":38.5,"operating_profit":-165954281.0,"operatin