장입니다. 화장품용 제품의 경우 피부에 직접 접촉되기 때문에 중금속, 미생물 등 까다로운 요건을 충족해야 합니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000535","hash":"2794a4fce27f07e3f1388ed6fe85ffe557861af4a377f925701376127190344e"},"previous":null,"added":[],"removed":[]},"employment_performance":{"status":"partial","employment":{"as_of":"202607","count":15.0,"previous_as_of":null,"previous_count":null,"growth_pct":null,"hire":0.0,"leave":0.0,"net":0.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":null,"previous_as_of":null,"revenue":null,"revenue_previous":null,"revenue_growth_pct":null,"operating_profit":null,"operating_profit_previous":null,"operating_profit_growth_pct":null,"source":"DART 연간 재무"},"relationship":"insufficient","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"ready","events":[{"date":"2024-06-28","category":"전환사채(CB)","title":"[기재정정]주요사항보고서(전환사채권발행결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20240628000001"},{"date":"2024-06-20","category":"전환사채(CB)","title":"[기재정정]주요사항보고서(전환사채권발행결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20240620000396"},{"date":"2024-06-19","category":"전환사채(CB)","title":"주요사항보고서(전환사채권발행결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20240619000418"},{"date":"2023-07-21","category":"자기주식처분","title":"[기재정정]주요사항보고서(자기주식처분결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20230721000558"},{"date":"2023-07-07","category":"자기주식처분","title":"[기재정정]주요사항보고서(자기주식처분결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20230707000408"},{"date":"2023-04-24","category":"자기주식처분","title":"[기재정정]주요사항보고서(자기주식처분결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20230424000390"},{"date":"2023-01-30","category":"자기주식처분","title":"주요사항보고서(자기주식처분결정)","is_correction":false,"source_url":"https://dart.fss.or