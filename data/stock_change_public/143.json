r":false,"capital_history":true}}},"143160":{"ticker":"143160","name":"아이디스","market":"KOSDAQ","today":{"status":"changed","as_of":"2026-08-21","previous_as_of":"2026-08-20","fields":[{"key":"price","label":"가격","before":16330.0,"after":16110.0,"delta":-220.0,"delta_pct":-1.35},{"key":"market_cap","label":"시가총액","before":158070325248.0,"after":155940765696.0,"delta":-2129559552.0,"delta_pct":-1.35}],"source":"data/stock_history 일별 스냅샷","disclosures":[]},"business_report":{"status":"unchanged","current":{"fiscal_year":"2025","filed_at":"20260318","report":"사업보고서 (2025.12)","text":"당사가 속해있는 영상보안산업은 크게 카메라 시장, 레코더 시장, VMS(Video Management Software) 시장 등으로 구분이 됩니다.당사는 1997년 설립 이후 기존 아날로그 레코더라고 불리는 DVR 시장에서 전 세계적으로 기술 및 품질에 대해 인정 받아 왔고, 최근 IP 기반 영상보안제품 수요가 확산됨에 따라 레코더 및 고해상도 IP 카메라와 VMS를 포함한 영상보안 토탈 솔루션을 개발, 생산, 판매하고 있습니다.당사의 초기 주력 제품이었던 DVR은 감시카메라에 입력된 영상 데이터를 디지털 신호로 전환하여 하드디스크 등에 압축ㆍ저장하는 영상보안장치이며, NVR은 네트워크 케이블을 통해 입ㆍ출력이 이미 압축되어 인코딩된 영상을 인터넷 프로토콜(이하IP)로 수신하여 녹화하는 영상보안장치입니다. IP Camera는 IP를 기반으로 카메라가 촬영한 감시 영상을 저장하고 전송하는 네트워크 감시 카메라입니다.당사의 별도 기준 제15기 매출은 2,129억으로, 제14기 4분기 대비 10% 증가하였습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001553","hash":"e01d030bbd3ea9b2844f1370e7219d2553044566e8d0ca5f003e6aaae6ca786c"},"previous":{"fiscal_year":"2025","filed_at":"20260318","report":"사업보고서 (2025.12)","text":"당사가 속해있는 영상보안산업은 크게 카메라 시장, 레코더 시장, VMS(Video Management Software) 시장 등으로 구분이 됩니다.당사는 1997년 설립 이후 기존 아날로그 레코더라고 불리는 DVR 시장에서 전 세계적으로 기술 및 품질에 대해 인정 받아 왔고, 최근 IP 기반 영상보안제품 수요가 확산됨에 따라 레코더 및 고해상도 IP 카메라와 VMS를 포함한 영상보안 토탈 솔루션을 개발, 생산, 판매하고 있습니다.당사의 초기 주력 제품이었던 DVR은 감시카메라에 입력된 영상 데이터를 디지털 신호로 전환하여 하드디스크 등에 압축ㆍ저장하는 영상보안장치이며, NVR은 네트워크 케이블을 통해 입ㆍ출력이 이미 압축되어 인코딩된 영상을 인터넷 프로토콜(이하IP)로 수신하여 녹화하는 영상보안장치입니다. IP Camera는 IP를 기반으로 카메라가 촬영한 감시 영상을 저장하고 전송하는 네트워크 감시 카메라입니다.당사의 별도 기준 제15기 매출은 2,129억으로, 제14기 4분기 대비 10% 증가하였습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001553","hash":"e01d030bbd3ea9b2844f1370e7219d25530445