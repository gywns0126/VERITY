 아웃도어 시장에서는 과불화 화합물(PFAS, Per(and Poly) Fluoroalkyl Substance)의 환경문제로 인하여 대체품을 찾는 노력이 진행되고 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260320001164","hash":"0548913c4d3aa6e99b2e1f71f40542b8e1f8bd425f7354e7918b655a951f8805"},"previous":null,"added":[],"removed":[]},"employment_performance":{"status":"ready","employment":{"as_of":"202607","count":97.0,"previous_as_of":null,"previous_count":null,"growth_pct":null,"hire":2.0,"leave":6.0,"net":-4.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":2025,"previous_as_of":2024,"revenue":7456806685.0,"revenue_previous":7288230562.0,"revenue_growth_pct":2.3,"operating_profit":-7144548463.0,"operating_profit_previous":-6283333118.0,"operating_profit_growth_pct":-13.7,"source":"DART 연간 재무"},"relationship":"insufficient","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"ready","events":[{"date":"2026-06-25","category":"유상증자","title":"주요사항보고서(유상증자결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260625000509"},{"date":"2024-02-27","category":"감자","title":"주요사항보고서(감자결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20240227004688"},{"date":"2023-10-05","category":"유상증자","title":"[기재정정]주요사항보고서(유상증자결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20231005000110"},{"date":"2023-08-29","category":"유상증자","title":"[기재정정]주요사항보고서(유상증자결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20230829000119"},{"date":"2023-07-20","category":"유상증자","title":"주요사항보고서(유상증자결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20230720000539"},{"date":"2020-02-18","category":"유상증자","title":"[기재정정]주요사항보고서(유상증자결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20200218000973"},{"date":"2020-01-20","category":"유상증자","title":"[기재정정]주요사항보고서(유상증자결정)","is_correction":false,"source_url":"