2.0,"after":216232656896.0,"delta":-781336576.0,"delta_pct":-0.36}],"source":"data/stock_history 일별 스냅샷","disclosures":[]},"business_report":{"status":"unchanged","current":{"fiscal_year":"2025","filed_at":"20260318","report":"사업보고서 (2025.12)","text":"당사는 자동차 부품 제조를 목적으로 1985년 설립되어 2001년 코스닥시장에 상장된기업입니다. 본사는 대구광역시 달서구 성서4차첨단로 392에 위치하고 있으며, 본 사업보고서 제출일 현재 646명의 임직원이 근무하고 있습니다. 당사는 허승현 단독대표이사 체제입니다. 당사의 관계사 현황은 국내 16개, 해외 16개의 회사가 있으며 (주)카펙발레오, (주)평화발레오, (주)브이피에이치아이 등 자동차 부품 단일사업을 영위 중입니다. 당사가 생산하고 있는 제품은 내부 인명 및 물품의 안정성을 확보하기 위한 DOOR MODULE, LATCH, HINGE, STRIKER, OTHER 등 5개의 제품군으로 구분됩니다.(1) 한국지역연결회사의 한국지역 소재 법인으로는 \"피에이치에이(주)\" 및 \"(주)에이에스티\"가 있습니다. 모기업인 피에이치에이(주)는 현대, 기아를 비롯하여 KGM(구, 쌍용), 르노코리아 등에 납품하고 있으며, 해외 직거래 업체로는 GM, PSA, OPEL, KEIKERT 등으로 수출하고 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000311","hash":"fe72c5497de87255950d7938275ece04784c09412a6763a8595a37bddfee2e15"},"previous":{"fiscal_year":"2025","filed_at":"20260318","report":"사업보고서 (2025.12)","text":"당사는 자동차 부품 제조를 목적으로 1985년 설립되어 2001년 코스닥시장에 상장된기업입니다. 본사는 대구광역시 달서구 성서4차첨단로 392에 위치하고 있으며, 본 사업보고서 제출일 현재 646명의 임직원이 근무하고 있습니다. 당사는 허승현 단독대표이사 체제입니다. 당사의 관계사 현황은 국내 16개, 해외 16개의 회사가 있으며 (주)카펙발레오, (주)평화발레오, (주)브이피에이치아이 등 자동차 부품 단일사업을 영위 중입니다. 당사가 생산하고 있는 제품은 내부 인명 및 물품의 안정성을 확보하기 위한 DOOR MODULE, LATCH, HINGE, STRIKER, OTHER 등 5개의 제품군으로 구분됩니다.(1) 한국지역연결회사의 한국지역 소재 법인으로는 \"피에이치에이(주)\" 및 \"(주)에이에스티\"가 있습니다. 모기업인 피에이치에이(주)는 현대, 기아를 비롯하여 KGM(구, 쌍용), 르노코리아 등에 납품하고 있으며, 해외 직거래 업체로는 GM, PSA, OPEL, KEIKERT 등으로 수출하고 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000311","hash":"fe72c5497de87255950d7938275ece04784c09412a6763a8595a37bddfee2e15"},"added":[],"removed":[]},"employment_performance":{"status":"ready","employment":{"as_of":"202607","count":652.0,"previous_as_of":"202606","previous_count":651.0,"growth_pct":0.2,"hire":5.0,"leave":0.0,"net":5.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":2025,"previous_as_of":2024,"revenue":1200673221564.0,"revenue_previous":1152879626217.0,"revenue_growth_pct":4.1,"operating_profit":48439190745.0,"operating_profit_previous":51478190517.0,"operating_profit_growth_pct":-5.9,"source":"DART 연간 재무"},"relationship":"mixed_direction","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"no_record","events":[],"event_total":0,"instruments":[],"dilution_pct":null,"note":"공시 제목 분류 이력이며 현재 잔존 물량 확정값이 아니다."},"coverage":{"hit":5,"total":6,"fields":{"daily_pair":true,"business_report":true,"business_previous":true,"employment":true,"financial_pair":true,"capital_history":false}}},"043360":{"ticker":"043360","name":"디지아이","market":"KOSDAQ","today":{"status":"insufficient_history","as_of":"","previous_as_of":null,"fields":[],"disclosures":[]},"business_report":{"status":"unchanged","current":{"fiscal_year":"2025","filed_at":"20260310","report":"사업보고서 (2025.12)","text":"1) 업계의 현황\n\n 정보통신의 발달과 디지털기술의 발전은 많은 산업의 구조를 첨단화시켰으며, 특히 디지털 기술의 급속한 발전이 광고산업에 적용되면서 광고의 자동제작을 가능하게 함으로써 광고산업이 본격적으로 성장하게 되었다. 1990년대 후반에 응용 개발된 커팅 플로터는 광고 산업의 발달로 시장규모가 크게확대되면서 광고제작의 자동화에 크게 기여했으며 사람이 직접 칼이나 붓을 이용해 광고물을 제작하던 노동집약적 산업에서 지식정보 집약적 첨단산업으로 전환시키는 계기를 제공하게 된다. 또한 디지털 기술의 발달과 이를 이용한 디지털 프린팅 기술이 발전함에 따라 실제모습을 있는 그대로 출력할 수 있는 사인 광고용 잉크젯 프린터가 등장하여 문자를 위주로 한 기존의 단순한 광고에서 사실적이고 아름다운 이미지의 광고 중심으로 전환하게 하였고, 디지털 프린팅 기술이 소재산업과 함께 발전하여 광고에 다양한 방식의 적용을 가능하게 함으로써 시장의 범위가 관련산업으로 확대 성장하고 있다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260310002586","hash":"f1d1a4612f89a2bdafc3d2ef738899460c095a15fce85cae51ec6cc493312d0c"},"previous":{"fiscal_year":"2025","filed_at":"20260310","report":"사업보고서 (2025.12)","text":"1) 업계의 현황\n\n 정보통신의 발달과 디지털기술의 발전은 많은 산업의 구조를 첨단화시켰으며, 특히 디지털 기술의 급속한 발전이 광고산업에 적용되면서 광고의 자동제작을 가능하게 함으로써 광고산업이 본격적으로 성장하게 되었다. 1990년대 후반에 응용 개발된 커팅 플로터는 광고 산업의 발달로 시장규모가 크게확대되면서 광고제작의 자동화에 크게 기여했으며 사람이 직접 칼이나 붓을 이용해 광고물을 제작하던 노동집약적 산업에서 지식정보 집약적 첨단산업으로 전환시키는 계기를 제공하게 된다. 또한 디지털 기술의 발달과 이를 이용한 디지털 프린팅 기술이 발전함에 따라 실제모습을 있는 그대로 출력할 수 있는 사인 광고용 잉크젯 프린터가 등장하여 문자를 위주로 한 기존의 단순한 광고에서 사실적이고 아름다운 이미지의 광고 중심으로 전환하게 하였고, 디지털 프린팅 기술이 소재산업과 함께 발전하여 광고에 다양한 방식의 적용을 가능하게 함으로써 시장의 범위가 관련산업으로 확대 성장하고 있다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260310002586","hash":"f1d1a4612f89a2bdafc3d2ef738899460c095a15fce85cae51ec6cc493312d0c"},"added":[],"removed":[]},"employment_performance":{"status":"partial","employment":{"as_of":"202607","count":3.0,"previous_as_of":null,"previous_count":null,"growth_pct":null,"hire":0.0,"leave":0.0,"net":0.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":null,"previous_as_of":null,"revenue":null,"revenue_previous":null,"revenue_growth_pct":null,"operating_profit":null,"operating_profit_previous":null,"operating_profit_growth_pct":null,"source":"DART 연간 재무"},"relationship":"insufficient","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"no_record","events":[],"event_total":0,"instruments":[],"dilution_pct":null,"note":"공시 제목 분류 이력이며 현재 잔존 물량 확정값이 아니다."},"coverage":{"hit":3,"total":6,"fields":{"daily_pair":false,"business_report":true,"business_previous":true,"employment":true,"financial_pair":false,"capital_history":false}}},"043340":{"ticker":"043340","name":"에쎈테크","market":"KOSDAQ","today":{"status":"changed","as_of":"2026-08-11","previous_as_of":"2026-08-07","fields":[{"key":"price","label":"가격","before":1000.0,"after":887.0,"delta":-113.0,"delta_pct":-11.3},{"key":"market_cap","label":"시가총액","before":47500001280.0,"after":42132500480.0,"delta":-5367500800.0,"delta_pct":-11.3}],"source":"data/stock_history 일별 스냅샷","disclosures":[]},"business_report":{"status":"unchanged","current":{"fiscal_year":"2025","filed_at":"20260317","report":"사업보고서 (2025.12)","text":"가. 업계의 현황\n\n에쎈테크는 동 및 동합금을 제조하는 금속가공업으로써 각종밸브 및 정밀부품을 생산하고 있습니다. 금속가공업은 주택, 전자, 전기, 석유, 화학, 자동차, 조선, 플랜트, 건설, 산업기계 등 대부분의 전방산업에 필수적으로 사용되는 요소 부품으로, 전방산업 경기에 직접적으로 노출되어 있고, 수요처별 맞춤형 주문 제조방식의 특성을 가진 사업입니다. 산업이 고도화될수록 수요의 증가가 늘어나고 있는 추세입니다.1) 업계개황동합금은 자동차밸브, LPG가스밸브, 도시가스, 냉온수관 등에 사용되고 있으며 국내관련 업계의 신규설비 투자로 품질이 고급화되면서 수출 또한 신장될 것으로 전망 됩니다.선진국에서는 납 중독으로 인한 환경 오염과 인체피해에 대한 우려로 음용수관을 동합금으로 사용 하도록 권장하고 있으며 국내 LPG차량의 증가 및 기존 차종인 소형승용차와 승합차에 LPG사용이 허가 된다면 동합금 제품인 LPG 밸브와 자동차밸브의소요는 더욱 증가될 수 있으며, 무거운 철강제품을 대신하여 가볍고 부식에 강한 동합금 제품의 사용 범위는 향후 산업이 고도화될수록 크게 증가될 것으로 예상됩니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000359","hash":"3c4847402b30d2f4962d0d452ba93d00579f3d5f0c246629f32261b97876a0ff"},"previous":{"fiscal_year":"2025","filed_at":"20260317","report":"사업보고서 (2025.12)","text":"가. 업계의 현황\n\n에쎈테크는 동 및 동합금을 제조하는 금속가공업으로써 각종밸브 및 정밀부품을 생산하고 있습니다. 금속가공업은 주택, 전자, 전기, 석유, 화학, 자동차, 조선, 플랜트, 건설, 산업기계 등 대부분의 전방산업에 필수적으로 사용되는 요소 부품으로, 전방산업 경기에 직접적으로 노출되어 있고, 수요처별 맞춤형 주문 제조방식의 특성을 가진 사업입니다. 산업이 고도화될수록 수요의 증가가 늘어나고 있는 추세입니다.1) 업계개황동합금은 자동차밸브, LPG가스밸브, 도시가스, 냉온수관 등에 사용되고 있으며 국내관련 업계의 신규설비 투자로 품질이 고급화되면서 수출 또한 신장될 것으로 전망 됩니다.선진국에서는 납 중독으로 인한 환경 오염과 인체피해에 대한 우려로 음용수관을 동합금으로 사용 하도록 권장하고 있으며 국내 LPG차량의 증가 및 기존 차종인 소형승용차와 승합차에 LPG사용이 허가 된다면 동합금 제품인 LPG 밸브와 자동차밸브의소요는 더욱 증가될 수 있으며, 무거운 철강제품을 대신하여 가볍고 부식에 강한 동합금 제품의 사용 범위는 향후 산업이 고도화될수록 크게 증가될 것으로 예상됩니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000359","hash":"3c4847402b30d2f4962d0d452ba93d00579f3d5f0c246629f32261b97876a0ff"},"added":[],"removed":[]},"employment_performance":{"status":"partial","employment":{"as_of":"202607","count":null,"previous_as_of":null,"previous_count":null,"growth_pct":null,"hire":null,"leave":null,"net":null,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":null,"previous_as_of":null,"revenue":null,"revenue_previous":null,"revenue_growth_pct":null,"operating_profit":null,"operating_profit_previous":null,"operating_profit_growth_pct":null,"source":"DART 연간 재무"},"relationship":"insufficient","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"ready","events":[{"date":"2023-11-30","category":"유상증자","title":"[기재정정]주요사항보고서(유상증자결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/m