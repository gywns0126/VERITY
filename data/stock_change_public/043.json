문제 등과 밀접하게 관련되어 있습니다. 이에 따라 주류 산업은 정부의 다양한 정책 및 규제와 유기적인 연관 관계를 형성하고 있습니다. 이러한 특성으로 인해 주류 산업은 타 산업에 비해 생산, 유통 및 소비 등 전 단계에 걸쳐 정부의 관리와 규제가 비교적 강하게 적용되고 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260814002401","hash":"ee1a33398df5779aa4c4d2e45f33198455c7a2cccb88bc0584ab980c826b15db"},"added":[],"removed":[]},"employment_performance":{"status":"ready","employment":{"as_of":"202607","count":252.0,"previous_as_of":"202606","previous_count":252.0,"growth_pct":0.0,"hire":3.0,"leave":5.0,"net":-2.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":2025,"previous_as_of":2024,"revenue":67498883797.0,"revenue_previous":68818650537.0,"revenue_growth_pct":-1.9,"operating_profit":-831886128.0,"operating_profit_previous":-2278660878.0,"operating_profit_growth_pct":63.5,"source":"DART 연간 재무"},"relationship":"mixed_direction","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"ready","events":[{"date":"2019-03-14","category":"자기주식처분","title":"주요사항보고서(자기주식처분결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20190314000691"},{"date":"2018-02-26","category":"자기주식처분","title":"주요사항보고서(자기주식처분결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20180226000286"},{"date":"2017-02-23","category":"자기주식처분","title":"주요사항보고서(자기주식처분결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20170223000155"},{"date":"2016-02-17","category":"자기주식처분","title":"주요사항보고서(자기주식처분결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20160217000186"},{"date":"2015-07-13","category":"자기주식처분","title":"주요사항보고서(자기주식처분결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20150713000211"},{"date":"2015-07-09","category":"자기주식처분","title":"주요사항보고서(자기주식처분결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20150709000224"},{"date":"2015-02-25","category":"자기주식처분","ti