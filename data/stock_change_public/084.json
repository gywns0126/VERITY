 사용자에게서 수취하는 상표권 사용수익, 자회사 경영자문 및 SSC 제공을 통한 경영자문수익, 자회사 및 기타 투자회사들로부터 받는 배당수익, 임대수익 등이 있습니다.","truncated":true,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001670","hash":"38bc7fbf2415615f06ff7bcd892ca36b24f829195fc0cac97de9d00af59c329a"},"previous":null,"added":[],"removed":[]},"employment_performance":{"status":"ready","employment":{"as_of":"202607","count":116.0,"previous_as_of":"202606","previous_count":118.0,"growth_pct":-1.7,"hire":0.0,"leave":3.0,"net":-3.0,"source":"국민연금공단 가입 사업장"},"performance":{"as_of":2025,"previous_as_of":2024,"revenue":847453173652.0,"revenue_previous":813460515145.0,"revenue_growth_pct":4.2,"operating_profit":90552351280.0,"operating_profit_previous":96990827338.0,"operating_profit_growth_pct":-6.6,"source":"DART 연간 재무"},"relationship":"mixed_direction","note":"고용과 실적의 방향을 나란히 놓은 사실 비교이며 인과관계나 전망이 아니다."},"capital_timeline":{"status":"ready","events":[{"date":"2026-06-22","category":"정정공시","title":"[기재정정]의결권대리행사권유참고서류","is_correction":true,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260622000310"},{"date":"2025-11-20","category":"자기주식처분","title":"[기재정정]주요사항보고서(자기주식처분결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20251120000501"},{"date":"2025-11-20","category":"교환사채(EB)","title":"[기재정정]주요사항보고서(교환사채권발행결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20251120000499"},{"date":"2025-11-10","category":"자기주식처분","title":"주요사항보고서(자기주식처분결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20251110000166"},{"date":"2025-11-10","category":"교환사채(EB)","title":"주요사항보고서(교환사채권발행결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20251110000165"},{"date":"2021-10-28","category":"전환사채(CB)","title":"주요사항보고서(전환사채권발행결정)","is_correction":false,"source_url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20211028000125"},{"date":"2016-08-12","category":"유상증자","title":"[기재정정]주요사항보고서(유상증자결정